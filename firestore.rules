rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["ciulbotak25@gmail.com"];
    }

    match /users/{userId} {
      // User cuma boleh baca profilnya sendiri. Admin boleh baca profil siapa aja.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Dipakai Panel Admin buat nampilin daftar semua user terdaftar.
      allow list: if isAdmin();

      // Cuma pemilik akun yang boleh nulis/update profilnya sendiri.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

